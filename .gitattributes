# Normalise line endings.
#
# Why this exists: the translator prompt assets in translator_prompts/ are
# generated by scripts/build_translator_kit.R via writeLines(useBytes = TRUE),
# which emits LF. Audit section H compares those generated files to the
# generator's output byte-for-byte. Without normalisation a CRLF checkout on
# Windows makes that check pass in CI and fail on the maintainer's machine.
#
# Development happens on Windows; CI and shinyapps.io run Linux.

* text=auto

# Text, always LF in the repository.
*.R          text eol=lf
*.r          text eol=lf
*.Rmd        text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.csv        text eol=lf
*.css        text eol=lf
*.html       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.dcf        text eol=lf
.gitignore   text eol=lf
.rscignore   text eol=lf
.Renviron    text eol=lf
.gitattributes text eol=lf

# Binary. Never touch these - several are Excel workbooks and rendered
# documents that git's heuristics could otherwise mangle.
*.xlsx       binary
*.xls        binary
*.docx       binary
*.doc        binary
*.pdf        binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.webp       binary
*.gif        binary
*.ico        binary
*.zip        binary
*.rds        binary
*.RData      binary
